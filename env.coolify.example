# ═══════════════════════════════════════════════
#  LiteLLM Enterprise - Coolify Environment Variables
# ═══════════════════════════════════════════════
#  Copy these into Coolify -> Environment Variables tab.
#  Generate secrets with: openssl rand -hex 32
# ═══════════════════════════════════════════════

# -- Core LiteLLM --
LITELLM_MASTER_KEY=sk-litellm-CHANGE-ME
OPENROUTER_API_KEY=sk-or-CHANGE-ME
UI_USERNAME=admin
UI_PASSWORD=CHANGE-ME-USE-STRONG-PASSWORD

# -- Database Passwords --
DB_PASSWORD=CHANGE-ME
LANGFUSE_DB_PASSWORD=CHANGE-ME

# -- Langfuse --
# Set NEXTAUTH_URL to your Langfuse domain (after Coolify assigns it)
LANGFUSE_NEXTAUTH_URL=https://langfuse.yourdomain.com
LANGFUSE_NEXTAUTH_SECRET=CHANGE-ME-64-HEX-CHARS
LANGFUSE_SALT=CHANGE-ME-64-HEX-CHARS
LANGFUSE_ENCRYPTION_KEY=CHANGE-ME-64-HEX-CHARS
# These are set AFTER first Langfuse login (create project -> get keys)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# -- ClickHouse --
CLICKHOUSE_PASSWORD=CHANGE-ME

# -- Redis --
REDIS_PASSWORD=CHANGE-ME

# -- MinIO --
MINIO_PASSWORD=CHANGE-ME

# -- SearXNG --
SEARXNG_BASE_URL=https://search.yourdomain.com
SEARXNG_SECRET=CHANGE-ME
